// Cloudflare Workers config. `npm run deploy` builds the site and uploads it as static assets
// with a tiny Worker in front that sends www.ananeo.app to ananeo.app.
// The custom domains below are attached automatically on deploy when the zone is in your account.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ananeo-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "ananeo.app", "custom_domain": true },
    { "pattern": "www.ananeo.app", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
