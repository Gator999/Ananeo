# Copy to .env (gitignored). Vite reads VITE_* at build time, so set the same values in
# Cloudflare (Workers & Pages > Settings > Variables) or in GitHub Actions for production builds.

# Supabase > Project Settings > API. The publishable (anon) key is safe to ship to browsers;
# Row Level Security decides what it can read.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Show a "Continue with Apple" button. Needs an Apple Services ID configured under
# Supabase > Authentication > Providers > Apple (web needs a Services ID, not the bundle ID).
VITE_APPLE_SIGN_IN=false
